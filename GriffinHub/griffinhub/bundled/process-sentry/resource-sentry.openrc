#!/sbin/openrc-run
# Process Sentry v3 — supervised by OpenRC's supervise-daemon (respawns on crash).
description="Process Sentry v3"
supervisor="supervise-daemon"
command="/usr/bin/python3"
command_args="/usr/local/bin/sentryv3.py"
# Respawn after 5s; give up after 10 respawns in 5 minutes (a missing Python
# module would otherwise loop forever — the OpenRC equivalent of systemd's
# start limit).
respawn_delay=5
respawn_max=10
respawn_period=300

depend() {
    need localmount
    # Soft ordering: only matters if kernel-autotune is installed.
    after kernel-autotune
    use logger
}
