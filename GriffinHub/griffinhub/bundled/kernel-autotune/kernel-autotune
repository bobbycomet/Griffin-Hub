# ==================== Status ====================
show_status() {
    # Fix #41: Inform non-root users explicitly if the log is unreadable.
    if [ ! -f "$STATE_FILE" ]; then
        echo "Not configured. Run 'install' first."
        exit 1
    fi

    echo "=== Kernel Autotune Status (v${SCRIPT_VERSION}) ==="

    # Fix #49: Show reconciliation between configured state and live state.
    echo "--- Configured State ---"
    cat "$STATE_FILE"
    echo

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$STATE_FILE" <<'PYEOF' 2>/dev/null || echo "(Could not parse state file)"
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print('Could not parse state file:', e)
    sys.exit(0)
print('System: %s (%s family), kernel %s [%s profile], init %s' % (
    d.get('distro_id', '?'), d.get('distro_family', '?'), d.get('kernel_mm', '?'),
    d.get('kernel', '?'), d.get('init_system', '?')))
print('Coexisting with: zram=%s, power=%s' % (d.get('zram_manager', 'none'), d.get('power_manager', 'none')))
print('Apply complete:', d.get('apply_complete', 'unknown'))
failed = d.get('failed_steps', [])
if failed:
    print('Failed steps:', ', '.join(failed))
eff = d.get('effective')
if eff:
    print('In effect: governor=%s (%s) THP=%s IO=%s zram=%s dev/%sMB' % (
        eff.get('cpu_governor'), eff.get('cpufreq_driver'), eff.get('thp_enabled'),
        eff.get('io_schedulers'), eff.get('zram_devices'), eff.get('zram_total_mb')))
PYEOF
    fi

    echo
    echo "--- Live ZRAM Swap ---"
    # /proc/swaps works with util-linux *and* busybox (whose swapon lacks --show).
    grep zram /proc/swaps 2>/dev/null || echo "No ZRAM active"

    echo
    echo "--- Logs (last 20 lines) ---"
    if [ -r "$LOG_FILE" ]; then
        tail -n 20 "$LOG_FILE"
    elif [ -f "$LOG_FILE" ]; then
        echo "Log exists but is not readable by current user (try sudo)"
    else
        echo "No logs yet"
    fi
}

# ==================== Main ====================
# Parse global flags before the subcommand
COMMAND=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run|-n)
            DRY_RUN=1
            shift
            ;;
        --quiet|-q)
            LOG_LEVEL=0
            shift
            ;;
        --verbose|-v)
            LOG_LEVEL=2
            shift
            ;;
        --version|-V)
            echo "kernel-autotune $SCRIPT_VERSION"
            exit 0
            ;;
        --help|-h)
            echo "Usage: $0 [--dry-run] [--quiet|--verbose] {install|apply|regen-config|uninstall|status|detect|--version}"
            echo
            echo "Commands:"
            echo "  install      Install and enable on boot (systemd, OpenRC, runit)"
            echo "  apply        Apply settings now (preserves config edits)"
            echo "  regen-config Regenerate config from hardware detection (backs up existing)"
            echo "  uninstall    Remove everything including logs"
            echo "  status       Show current configuration and state"
            echo "  detect       Print what was detected (distro, kernel, init, capabilities)"
            echo
            echo "Flags (can appear before the command):"
            echo "  --dry-run    Print what would be done without making any changes"
            echo "  --quiet      Suppress informational output (warnings/errors still shown)"
            echo "  --verbose    Show per-device and per-step detail"
            echo "  --version    Print version and exit"
            echo "  --help       Show this help"
            echo
            echo "Config file: $CONFIG_FILE"
            exit 0
            ;;
        -*)
            echo "Unknown flag: $1" >&2
            echo "Run '$0 --help' for usage." >&2
            exit 1
            ;;
        *)
            COMMAND="$1"
            shift
            break
            ;;
    esac
done

init_paths
trap 'rc=$?; if [ -n "${DRYRUN_TMP:-}" ]; then rm -rf "$DRYRUN_TMP"; fi; exit $rc' EXIT

if [ "$DRY_RUN" = "1" ]; then _write_log "Invoked with --dry-run"; fi
if [ "$LOG_LEVEL" -eq 0 ]; then _write_log "Invoked with --quiet"; fi
if [ "$LOG_LEVEL" -eq 2 ]; then _write_log "Invoked with --verbose"; fi

case "${COMMAND:-apply}" in
    install)
        acquire_lock
        install
        ;;
    apply)
        need_root
        acquire_lock
        apply_all
        ;;
    regen-config)
        need_root
        acquire_lock
        regen_config
        ;;
    uninstall)
        need_root
        acquire_lock
        uninstall
        ;;
    status)
        show_status
        ;;
    detect)
        show_detection
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run '$0 --help' for usage." >&2
        exit 1
        ;;
esac
