    local dev="desktop"
    if is_handheld; then dev="handheld"; elif is_laptop; then dev="laptop"; fi
    echo "distro=$(get_distro)"
    echo "distro_id=$(detect_distro_id)"
    echo "distro_family=$(detect_distro_family)"
    echo "package_manager=$(detect_pkg_manager)"
    echo "init_system=$(detect_init_system)"
    echo "kernel_release=$(_uname_r)"
    echo "kernel_profile=$(detect_kernel)"
    echo "kernel_mm=$(get_kernel_mm)"
    echo "preempt_model=$(get_preempt_model)"
    echo "cgroup_version=$(get_cgroup_version)"
    echo "psi=$(has_psi && echo 1 || echo 0)"
    echo "container=$(is_container && echo 1 || echo 0)"
    echo "root_readonly=$(root_is_readonly && echo 1 || echo 0)"
    echo "device_type=$dev"
    echo "cpufreq_driver=$(get_cpufreq_driver)"
