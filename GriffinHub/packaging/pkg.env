# Shared packaging metadata -- edit here, every build script reads this file.
PKG_NAME=griffinhub
PKG_SUMMARY="Linux system tuning, hardware drivers, controller and WiFi fixes, and Steam/Proton fixes"
PKG_DESCRIPTION="Griffin Hub bundles Kernel Autotune, Process Sentry, distro-native driver installers for GPUs, game controllers and WiFi chips, the Griffin Play Steam/Proton fix tab, and Griffin Game Tweaks (set up Windows launchers with Proton)."
PKG_MAINTAINER="Bobby Comet <bobbycomet@users.noreply.github.com>"
PKG_HOMEPAGE="https://github.com/bobbycomet"
# No license is declared anywhere in the sources.  Set the real one before public distribution
# (SPDX id for rpm, e.g. GPL-3.0-or-later / MIT; plain text for the deb copyright file).
PKG_LICENSE_SPDX="LicenseRef-Unspecified"
PKG_LICENSE_TEXT="The author has not specified a license for this software. All rights reserved by the copyright holder until one is added."
